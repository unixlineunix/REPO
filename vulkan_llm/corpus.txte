#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <unistd.h>

typedef struct {
    int x, y;
    int w, h;
} Rect;

Rect rect_new(int x, int y, int w, int h) {
    Rect r = {x, y, w, h};
    return r;
}

int rect_area(Rect* r) {
    return r->w * r->h;
}

void* worker_thread(void* arg) {
    int* id = (int*)arg;
    printf("Thread %d starting\n", *id);
    for (int i = 0; i < 5; i++) {
        sleep(1);
        printf("Thread %d: iteration %d\n", *id, i);
    }
    return NULL;
}

int main(int argc, char** argv) {
    pthread_t threads[4];
    int ids[4];
    for (int i = 0; i < 4; i++) {
        ids[i] = i;
        pthread_create(&threads[i], NULL, worker_thread, &ids[i]);
    }
    for (int i = 0; i < 4; i++) {
        pthread_join(threads[i], NULL);
    }
    printf("All threads done\n");
    return 0;
}

